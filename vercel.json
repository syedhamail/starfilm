  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/google94a976b56e3b917b.html",
      "headers": { "Content-Type": "text/plain" },
